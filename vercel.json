{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app/browser",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/dist/app/server/server.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/app/browser/$1"
    }
  ]
}
